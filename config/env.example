# Copy this file to .env for local development.
# Never commit your real .env file or API token to GitHub.

# Local development is the safe default. Cloud Run explicitly sets production.
STOCKPULSE_ENVIRONMENT=development

APIFY_API_TOKEN=replace_with_your_apify_token
APIFY_ACTOR_ID=automation-lab/stocktwits-scraper
APIFY_MAX_TOTAL_CHARGE_USD=0.05
STOCKPULSE_SYMBOL=TSLA
STOCKPULSE_MAX_MESSAGES=5
STOCKPULSE_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
STOCKPULSE_SENTIMENT_MODEL_REVISION=3216a57f2a0d9c45a2e6c20157c20c49fb4bf9c7
STOCKPULSE_SENTIMENT_THRESHOLD=0.60

# Keep SQLite for local development. Production supplies the PostgreSQL URL
# through a secret at runtime; never commit a real connection URL.
STOCKPULSE_DATABASE_BACKEND=sqlite
STOCKPULSE_DATABASE_POOL_MIN_SIZE=1
STOCKPULSE_DATABASE_POOL_MAX_SIZE=4
# STOCKPULSE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stockpulse

# Manual action APIs stay disabled unless this separate 32+ character secret
# and a deployment-specific job dispatcher are both configured.
# STOCKPULSE_ACTION_API_TOKEN=replace_with_a_long_random_action_secret

# Optional email delivery. Use a Gmail App Password, never the normal account
# password. Production injects the app password from Secret Manager.
STOCKPULSE_EMAIL_ENABLED=false
# STOCKPULSE_SMTP_USERNAME=owner@example.com
# STOCKPULSE_SMTP_APP_PASSWORD=replace_with_a_gmail_app_password
# STOCKPULSE_EMAIL_FROM=owner@example.com
# STOCKPULSE_EMAIL_TO=owner@example.com
STOCKPULSE_DAILY_EMAIL_AFTER_HOUR=14
STOCKPULSE_EMAIL_TIMEZONE=America/Los_Angeles
