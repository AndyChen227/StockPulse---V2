# Copy this file to .env when Phase 2 begins.
# Never commit your real .env file or API token to GitHub.

APIFY_API_TOKEN=replace_with_your_apify_token
APIFY_ACTOR_ID=automation-lab/stocktwits-scraper
APIFY_MAX_TOTAL_CHARGE_USD=0.05
STOCKPULSE_SYMBOL=TSLA
STOCKPULSE_MAX_MESSAGES=5
STOCKPULSE_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
STOCKPULSE_SENTIMENT_THRESHOLD=0.60
